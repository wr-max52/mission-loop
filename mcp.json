{
  "search": {
    "command": "npx",
    "args": ["-y", "@brave/brave-search-mcp-server"],
    "requires": ["BRAVE_API_KEY"],
    "env": {
      "BRAVE_API_KEY": "${BRAVE_API_KEY}",
      "BRAVE_MCP_ENABLED_TOOLS": "brave_web_search brave_news_search"
    }
  },
  "fetch": {
    "command": "uvx",
    "args": ["mcp-server-fetch"]
  },
  "pages": {
    "command": "python",
    "args": ["page_tools.py"]
  },
  "loop": {
    "command": "python",
    "args": ["status_tools.py"]
  },
  "library": {
    "command": "python",
    "args": ["library_tools.py"]
  },
  "outreach": {
    "command": "python",
    "args": ["outreach_tools.py"]
  }
}
