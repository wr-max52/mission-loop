# Search API key for the MCP search server in mcp.json. Pasting it on the home page's Get started card or on
# Settings → Web search saves it in data/search.json instead, which wins over this.
BRAVE_API_KEY=
# TAVILY_API_KEY=
# Everything below is optional: the UI's Settings page saves the same choices in data/settings.json,
# which wins over this file. Nothing here is built into the code.
#
# Models: the code has none built in. Pick each worker's model on the Settings page, or set them here:
# a bare name from `ollama list` for Ollama, or <provider>/<model> for a cloud provider below
# (e.g. anthropic/<model>, openai/<model>, xai/<model>, deepseek/<model>, openrouter/<lab>/<model>).
# MISSION_LOOP_MODEL=<big model: the Principal Investigator, writes briefs and articles>
# MISSION_LOOP_SEARCH_MODEL=<small model: the Research Assistant, searches and reads pages>
# MISSION_LOOP_CHAT_MODEL=<the chat assistant's model; default: the Research Assistant's, already loaded>
#
# Where Ollama runs (default: Ollama's standard local address, http://127.0.0.1:11434)
# OLLAMA_HOST=http://127.0.0.1:11434
#
# Cloud model providers: a key here turns one on, like pasting it on the Settings page (which wins over this file).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# Any OpenAI-compatible server (LM Studio, vLLM, llama.cpp, LiteLLM): its address, and a key if it wants one
# MISSION_LOOP_COMPAT_URL=http://127.0.0.1:1234/v1
# MISSION_LOOP_COMPAT_KEY=
#
# Which 1F916 server to join (default: https://1f916.ai). Once joined, the key file records its server.
# MISSION_LOOP_1F916_URL=https://1f916.ai
#
# Bluesky: a login here instead of on the Settings page, and its server (default: https://bsky.social)
# BLUESKY_HANDLE=
# BLUESKY_APP_PASSWORD=
# BLUESKY_SERVICE=https://bsky.social
#
# GitHub Pages: connect on the Settings page (GitHub's own sign-in, nothing typed here). These are only for a
# GitHub Enterprise server (default: https://github.com) or a fork with its own OAuth app (Device Flow on).
# MISSION_LOOP_GITHUB_URL=https://github.com
# MISSION_LOOP_GITHUB_CLIENT_ID=
